# Tiempo de vida del access token (formato zeit/ms: "15m", "1h", "3600", etc.)
JWT_ACCESS_TTL="15m"
# Tiempo de vida del refresh token
JWT_REFRESH_TTL="7d"
# Ventana de gracia tras la expiración del access token durante la cual todavía
# se permite renovarlo automáticamente sin volver a hacer login (en segundos).
JWT_RENEWAL_GRACE_SECONDS="300"

# --- Cifrado AES de datos sensibles (nombre, correo) ---
# Debe ser una clave de 32 bytes en hexadecimal (64 caracteres hex) para AES-256-GCM.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_ENCRYPTION_KEY="5103a40dbe864003555efc56cb33c954f50922b32f6f4f996943efdc70d3f2de"
# Clave para el HMAC-SHA256 usado como índice de búsqueda del correo (no reversible)
EMAIL_HASH_SECRET="d54985bb026a0c6f0fc4db4e30db43d6b347adb915d9e2fe8f478881f0882722"

# --- Microservicio de autorización ---
AUTHORIZATION_SERVICE_URL="http://localhost:4001"
# Debe coincidir con JWT_ACCESS_SECRET del authorization-service para poder
# verificar la firma del token
AUTHORIZATION_RETRY_MAX_ATTEMPTS="4"
# Backoff inicial en ms; cada intento espera backoff * (2 ^ intento)
AUTHORIZATION_RETRY_BASE_DELAY_MS="200"
AUTHORIZATION_RETRY_TIMEOUT_MS="2000"

# --- Servidor ---
PORT="3000"
